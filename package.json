{
  "name": "dsh-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "生态雷达：DSH 插件与 Agent Skills 的排行导航，侧栏一键打开，可复制提示词让会话直接安装",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "data/radar.json",
    "locale/*.json",
    "docs/DETAIL.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.2 <0.4.0-0"
  }
}
